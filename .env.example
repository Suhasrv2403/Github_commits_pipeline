# Example environment file for local/Docker runs of the ELT pipeline.
# Copy to `.env` (already gitignored) and fill in real values — never commit
# the populated `.env` file.
#
# Consumed by:
#   - src/extract.py (GITHUB_TOKEN, AWS_*)
#   - airflow/dags/elt_dag.py (all of the below, merged into task env)
#   - transform/my_pipeline/profiles.yml (SNOWFLAKE_*, your local dbt profile —
#     not checked in; see ci_profiles.yml for the CI equivalent)

# --- GitHub extraction (src/extract.py) ---
GITHUB_TOKEN=

# --- AWS S3 (raw commit JSON landing zone) ---
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Snowflake (dbt transformation layer) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=accountadmin

# --- Pipeline tuning (currently hardcoded as constants in src/extract.py; ---
# --- not yet read from the environment — listed here for visibility/future wiring) ---
# GITHUB_REPO_OWNER=apache
# GITHUB_REPO_NAME=airflow
# GITHUB_MAX_PAGES=5
# GITHUB_PER_PAGE=30
